# CASEVAC Admin Dashboard — environment template.
# Copy to .env.local and fill in. Never commit .env.local.

# Signs the demo admin session cookie. Use a random value of 32+ characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CASEVAC_SESSION_SECRET=

# DEMO administrator account (mock authentication — not production security).
DEMO_ADMIN_ID=ADM-DEMO-01
DEMO_ADMIN_NAME=Demo Administrator
DEMO_ADMIN_PASSWORD=

# Data source: "demo-file" (local JSON, fictional data only). "backend" is not implemented yet.
CASEVAC_DATA_SOURCE=demo-file
# Optional: override the demo data file location (default: ./.data/casevac-demo-db.json)
# CASEVAC_DEMO_DATA_FILE=
# QR issuer signing key (Ed25519). DEVELOPMENT ONLY — generate with `npm run issuer:keygen`,
# which writes both values into .env.local. Never commit a private key.
CASEVAC_QR_ISSUER_KEY_ID=
CASEVAC_QR_ISSUER_PRIVATE_KEY=

# Unit transfer key: encrypts casualty records handed from one medic tablet to another
# (QR / Bluetooth). Sent to tablets at sign-in. DEVELOPMENT ONLY — generate with
# `npm run transfer:keygen`, which writes both values into .env.local. Never commit it.
CASEVAC_TRANSFER_KEY_ID=
CASEVAC_TRANSFER_KEY=

# Encrypts medic app sign-in passwords so an admin can view them again on the dashboard
# after verifying with Windows Hello (or the admin password). 32 random bytes, base64url:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it out of the data file and source control. Changing it makes stored passwords
# unviewable (reset them to fix). Leave empty to disable password viewing.
CASEVAC_LOGIN_VAULT_KEY=
# Optional: the dashboard's public URL (e.g. https://admin.casevac.example). Pins the site
# Windows Hello verification is tied to; defaults to the request host.
# CASEVAC_DASHBOARD_ORIGIN=
