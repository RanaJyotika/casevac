# CASEVAC Admin Dashboard — environment template.
# Copy to .env.local and fill in. Never commit .env.local.

# Signs the demo admin session cookie. Use a random value of 32+ characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CASEVAC_SESSION_SECRET=

# DEMO administrator account (mock authentication — not production security).
DEMO_ADMIN_ID=ADM-DEMO-01
DEMO_ADMIN_NAME=Demo Administrator
DEMO_ADMIN_PASSWORD=

# Data source: "demo-file" (local JSON, fictional data only). "backend" is not implemented yet.
CASEVAC_DATA_SOURCE=demo-file
# Optional: override the demo data file location (default: ./.data/casevac-demo-db.json)
# CASEVAC_DEMO_DATA_FILE=
# QR issuer signing key (Ed25519). DEVELOPMENT ONLY — generate with `npm run issuer:keygen`,
# which writes both values into .env.local. Never commit a private key.
CASEVAC_QR_ISSUER_KEY_ID=
CASEVAC_QR_ISSUER_PRIVATE_KEY=
